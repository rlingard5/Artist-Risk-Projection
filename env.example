# Rename this file to ".env" and fill in your real values.

# Spotify: used only for artist name search + photo now (Client Credentials
# flow). Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Last.fm: used for listeners, playcount, and top-track data — the numbers
# Spotify's API no longer exposes to standard apps. Free, no app review
# needed. Get one at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here
